{
  "name": "mnemos",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Dual-agent cognitive harness runtime",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "eval:retrieval": "vitest run packages/storage/src/retrieval.test.ts",
    "eval:ptc": "vitest run packages/storage/src/ptc.test.ts",
    "eval:tools": "vitest run packages/core/src/tool-discovery.test.ts",
    "eval:context": "vitest run packages/core/src/context-intelligence.test.ts",
    "eval:memory": "vitest run --config vitest.eval.config.ts packages/storage/src/memory-intelligence.eval.ts",
    "eval:reliability": "vitest run --config vitest.eval.config.ts packages/storage/src/reliability.eval.ts",
    "eval:soak": "vitest run --config vitest.eval.config.ts packages/storage/src/reliability-soak.eval.ts",
    "chat": "pnpm --filter @mnemos/cli start"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
